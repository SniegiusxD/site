# Server-side only — Flask API on VPS (no trailing slash)
API_URL=http://localhost:5001

# Public canonical origin used by Better Auth callbacks (no trailing slash).
BETTER_AUTH_URL=https://example.com

# Server-only secrets and database connection. Production rewrites sslmode to
# verify-full so the PostgreSQL certificate and hostname are verified.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full

# Stripe billing. Test keys (sk_test_/pk_test_) locally and in Preview; the live
# pair only in Production, and only when charging is meant to start. Without
# STRIPE_SECRET_KEY the site shows "Mokėjimai įjungiami netrukus" instead of a
# checkout. The webhook secret comes from the endpoint registered in Stripe for
# /api/billing/webhook.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Shared serverless rate-limit store (Upstash). The Vercel Marketplace install
# names these KV_REST_API_URL / KV_REST_API_TOKEN; either pair works. In production protected routes fail
# closed with 503 until both values are configured.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Who may open /savininkas (the owner dashboard). Comma separated emails of
# existing accounts. Empty: nobody; the page is a 404 for everyone else.
OWNER_EMAILS=

# Server-side only — Flask API on VPS (no trailing slash)
API_URL=http://localhost:5001

# Stripe billing. Test keys (sk_test_/pk_test_) locally and in Preview; the live
# pair only in Production, and only when charging is meant to start. Without
# STRIPE_SECRET_KEY the site shows "Mokėjimai įjungiami netrukus" instead of a
# checkout. The webhook secret comes from the endpoint registered in Stripe for
# /api/billing/webhook.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
